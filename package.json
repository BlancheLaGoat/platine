{
  "name": "platine",
  "productName": "Platine",
  "version": "1.8.0",
  "description": "Toutes tes plateformes de musique (Tidal, Spotify, Deezer…) dans une appli desktop stable, qualité max (Widevine).",
  "main": "src/main.js",
  "author": "BlancheLaGoat",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "https://github.com/castlabs/electron-releases#v44.5.1+wvcus",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.blanchelagoat.platine",
    "productName": "Platine",
    "electronVersion": "44.5.1",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "afterSign": "./scripts/evs-sign.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "electronDownload": {
      "version": "44.5.1+wvcus",
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "BlancheLaGoat",
        "repo": "platine"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "@xhayper/discord-rpc": "^1.5.1"
  }
}
